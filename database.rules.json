{
  "rules": {
    ".read": "auth != null",
    "liveLocations": {
      "$busId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['latitude', 'longitude', 'timestamp', 'speed', 'accuracy'])"
      }
    },
    "activeTrips": {
      "$tripId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "busPresence": {
      "$busId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "activeIncidents": {
      "$incidentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "liveTripStatuses": {
      "$tripId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}

